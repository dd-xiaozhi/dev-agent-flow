{
  "flow_id": "bugfix-spec",
  "version": "1.1",
  "description": "Bug 修复（spec 档）：复杂缺陷需契约 → planner → generator → evaluator → 推送 → 合并 → 部署 → TAPD 关单 → 收尾(回填 _index.jsonl)。",
  "steps": [
    {
      "id": "doc-librarian",
      "kind": "agent",
      "target": "doc-librarian",
      "phase_alias": "doc-librarian",
      "on_complete_event": "contract:frozen"
    },
    {
      "id": "planner",
      "kind": "agent",
      "target": "planner",
      "phase_alias": "planner",
      "on_complete_event": "planner:all-cases-ready"
    },
    {
      "id": "generator",
      "kind": "agent",
      "target": "generator",
      "phase_alias": "generator",
      "on_complete_event": "generator:all-done"
    },
    {
      "id": "evaluator",
      "kind": "agent",
      "target": "evaluator",
      "phase_alias": "evaluator",
      "on_complete_event": "evaluator:done"
    },
    {
      "id": "git-push",
      "kind": "skill",
      "target": "git",
      "action": "commit-push",
      "phase_alias": "git-push",
      "on_complete_event": "git:pushed"
    },
    {
      "id": "merge",
      "kind": "skill",
      "target": "git",
      "action": "merge",
      "phase_alias": "merge",
      "on_complete_event": "git:merged"
    },
    {
      "id": "deploy",
      "kind": "skill",
      "target": "jenkins-deploy",
      "phase_alias": "deploy",
      "on_complete_event": "jenkins:deployed"
    },
    {
      "id": "tapd-close",
      "kind": "command",
      "target": "/tapd close",
      "phase_alias": "tapd-close",
      "on_complete_event": "tapd:closed",
      "args_from": ["task_id"]
    },
    {
      "id": "finalize",
      "kind": "tool",
      "target": "Bash",
      "phase_alias": "finalize",
      "command_template": "python .claude/skills/task/scripts/task.py finalize {task_id}",
      "args_from": ["task_id"],
      "on_complete_event": "task:finalized"
    },
    {
      "id": "done",
      "kind": "terminal",
      "target": null,
      "phase_alias": "done",
      "on_complete_event": null
    }
  ]
}
