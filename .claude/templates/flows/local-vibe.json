{
  "flow_id": "local-vibe",
  "version": "1.1",
  "description": "非 TAPD 小型任务：Read → Edit → 留痕 patch.md → 推送代码 → 部署。不调 agent。task 目录由 task.py new 创建。",
  "steps": [
    {
      "id": "edit",
      "kind": "tool",
      "target": "Edit",
      "phase_alias": "edit",
      "on_complete_event": null
    },
    {
      "id": "patch-record",
      "kind": "tool",
      "target": "Write",
      "phase_alias": "patch-record",
      "template_path": ".claude/templates/patch-template.md",
      "output_path_template": ".chatlabs/task/store/{story_id}/patch.md",
      "args_from": ["story_id"],
      "on_complete_event": "patch:recorded"
    },
    {
      "id": "git-push",
      "kind": "skill",
      "target": "git",
      "action": "commit-push",
      "phase_alias": "git-push",
      "on_complete_event": "git:pushed"
    },
    {
      "id": "merge",
      "kind": "skill",
      "target": "git",
      "action": "merge",
      "phase_alias": "merge",
      "on_complete_event": "git:merged"
    },
    {
      "id": "deploy",
      "kind": "skill",
      "target": "jenkins-deploy",
      "phase_alias": "deploy",
      "on_complete_event": "jenkins:deployed"
    },
    {
      "id": "finalize",
      "kind": "tool",
      "target": "Bash",
      "phase_alias": "finalize",
      "command_template": "python .claude/skills/task/scripts/task.py finalize {task_id}",
      "args_from": ["task_id"],
      "on_complete_event": "task:finalized"
    },
    {
      "id": "done",
      "kind": "terminal",
      "target": null,
      "phase_alias": "done",
      "on_complete_event": null
    }
  ]
}
