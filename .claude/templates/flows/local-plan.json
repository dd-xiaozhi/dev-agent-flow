{
  "flow_id": "local-plan",
  "version": "1.1",
  "description": "非 TAPD 中型任务：TodoWrite → Edit → 推送代码 → 部署 → 收尾(回填 _index.jsonl)。不调任何 agent。",
  "steps": [
    {
      "id": "todo-write",
      "kind": "tool",
      "target": "TaskCreate",
      "phase_alias": "todo-write",
      "on_complete_event": null
    },
    {
      "id": "edit",
      "kind": "tool",
      "target": "Edit",
      "phase_alias": "edit",
      "on_complete_event": null
    },
    {
      "id": "git-push",
      "kind": "skill",
      "target": "git",
      "action": "commit-push",
      "phase_alias": "git-push",
      "on_complete_event": "git:pushed"
    },
    {
      "id": "merge",
      "kind": "skill",
      "target": "git",
      "action": "merge",
      "phase_alias": "merge",
      "on_complete_event": "git:merged"
    },
    {
      "id": "deploy",
      "kind": "skill",
      "target": "jenkins-deploy",
      "phase_alias": "deploy",
      "on_complete_event": "jenkins:deployed"
    },
    {
      "id": "finalize",
      "kind": "tool",
      "target": "Bash",
      "phase_alias": "finalize",
      "command_template": "python .claude/skills/task/scripts/task.py finalize {task_id}",
      "args_from": ["task_id"],
      "on_complete_event": "task:finalized"
    },
    {
      "id": "done",
      "kind": "terminal",
      "target": null,
      "phase_alias": "done",
      "on_complete_event": null
    }
  ]
}
