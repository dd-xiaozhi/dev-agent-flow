{
  "flow_id": "bugfix-vibe",
  "version": "1.2",
  "description": "Bug 修复（vibe 档）：单点改动 → 留痕 patch.md → 推送代码 → 合并到目标分支 → 部署 → TAPD 关单 → 收尾(回填 _index.jsonl)。不调 agent。",
  "steps": [
    {
      "id": "edit",
      "kind": "tool",
      "target": "Edit",
      "phase_alias": "edit",
      "on_complete_event": null
    },
    {
      "id": "patch-record",
      "kind": "tool",
      "target": "Write",
      "phase_alias": "patch-record",
      "template_path": ".claude/templates/patch-template.md",
      "output_path_template": "docs/task/bug-fix/{task_id}/patch.md",
      "args_from": ["task_id"],
      "on_complete_event": "patch:recorded"
    },
    {
      "id": "git-push",
      "kind": "skill",
      "target": "git",
      "action": "commit-push",
      "phase_alias": "git-push",
      "on_complete_event": "git:pushed"
    },
    {
      "id": "merge",
      "kind": "skill",
      "target": "git",
      "action": "merge",
      "phase_alias": "merge",
      "on_complete_event": "git:merged"
    },
    {
      "id": "deploy",
      "kind": "skill",
      "target": "jenkins-deploy",
      "phase_alias": "deploy",
      "on_complete_event": "jenkins:deployed"
    },
    {
      "id": "tapd-close",
      "kind": "command",
      "target": "/tapd close",
      "phase_alias": "tapd-close",
      "on_complete_event": "tapd:closed",
      "args_from": ["task_id"]
    },
    {
      "id": "branch-cleanup",
      "kind": "skill",
      "target": "git",
      "action": "cleanup",
      "phase_alias": "branch-cleanup",
      "args_from": ["git.branch", "git.branch_type", "git.worktree_path"],
      "on_complete_event": "branch:cleaned"
    },
    {
      "id": "finalize",
      "kind": "tool",
      "target": "Bash",
      "phase_alias": "finalize",
      "command_template": "python .claude/skills/task/scripts/task.py finalize {task_id}",
      "args_from": ["task_id"],
      "on_complete_event": "task:finalized"
    },
    {
      "id": "done",
      "kind": "terminal",
      "target": null,
      "phase_alias": "done",
      "on_complete_event": null
    }
  ]
}
