{
  "flow_id": "bugfix-plan",
  "version": "1.0",
  "description": "Bug 修复（plan 档）：TodoWrite 拆解 → Edit 修复 → 推送代码 → 合并到目标分支 → 部署 → TAPD 关单。不调 agent。",
  "steps": [
    {
      "id": "todo-write",
      "kind": "tool",
      "target": "TaskCreate",
      "phase_alias": "todo-write",
      "on_complete_event": null
    },
    {
      "id": "edit",
      "kind": "tool",
      "target": "Edit",
      "phase_alias": "edit",
      "on_complete_event": null
    },
    {
      "id": "git-push",
      "kind": "skill",
      "target": "git",
      "action": "commit-push",
      "phase_alias": "git-push",
      "on_complete_event": "git:pushed"
    },
    {
      "id": "merge",
      "kind": "skill",
      "target": "git",
      "action": "merge",
      "phase_alias": "merge",
      "on_complete_event": "git:merged"
    },
    {
      "id": "deploy",
      "kind": "skill",
      "target": "jenkins-deploy",
      "phase_alias": "deploy",
      "on_complete_event": "jenkins:deployed"
    },
    {
      "id": "tapd-close",
      "kind": "command",
      "target": "/tapd close",
      "phase_alias": "tapd-close",
      "on_complete_event": "tapd:closed",
      "args_from": ["task_id"]
    },
    {
      "id": "finalize",
      "kind": "tool",
      "target": "Bash",
      "phase_alias": "finalize",
      "command_template": "python .claude/skills/task/scripts/task.py finalize {task_id}",
      "args_from": ["task_id"],
      "on_complete_event": "task:finalized"
    },
    {
      "id": "done",
      "kind": "terminal",
      "target": null,
      "phase_alias": "done",
      "on_complete_event": null
    }
  ]
}
