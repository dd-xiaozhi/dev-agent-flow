# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# ── Flow 代码 (.claude/) — 部分提交 ────────────────────────
# .claude/ agents/ commands/ hooks/ scripts/ skills/ templates/ are committed
# Local settings / runtime state are user-specific
.claude/settings.local.json
.claude/.current_task
.claude/.gc_last_run
.claude/hooks/__pycache__/
.claude/scripts/__pycache__/

# ── Runtime artifacts (docs/) ────────────────────────────────────────
# User-specific local state — never committed
docs/state/
docs/tapd/tickets/

# Committable artifacts (useful for team review / workflow tracking)
docs/stories/
docs/task/
docs/worktrees/
docs/reports/

# Environment variables (contains secrets — never commit)
.env

# MCP server config (contains plaintext tokens — keep local only)
.mcp.json

# Logs
*.log

# Playwright MCP page snapshots (large YAML cache, regenerated per session)
.playwright-mcp/
