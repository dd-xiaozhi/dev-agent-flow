{
  "ssh_servers": [
    {
      "env": "dev",
      "name": "开发环境",
      "host": "43.138.188.219",
      "port": 22,
      "user": "dev",
      "password_env": "SSH_DEV_PASSWORD2"
    },
    {
      "env": "uat",
      "name": "用户测试环境",
      "host": "43.138.188.219",
      "port": 22,
      "user": "dev",
      "password_env": "SSH_DEV_PASSWORD"
    }
  ],
  "log": {
    "paths": [
      {
        "env": "dev",
        "dir": "/app/log/bde-chopard-dev/debug",
        "pattern": "log_debug_{date}.{seq}.log"
      },
      {
        "env": "uat",
        "dir": "/app/log/bde-chopard-uat/debug",
        "pattern": "debug-{date}.{seq}.log"
      }
    ],
    "output_dir": ".chatlabs/logs_query/{env}"
  },
  "jenkins": {
    "notify_on_success": true,
    "notify_on_failure": true,
    "poll_interval_seconds": 30,
    "timeout_minutes": 15,
    "envs": [
      {
        "env": "dev",
        "job": "bde-debeers-be-staging",
        "branch": "dev-cpwx-wecom-bot-test"
      },
      {
        "env": "uat",
        "job": null,
        "branch": null
      }
    ]
  },
  "tapd": {
    "enabled": false,
    "workspace_id": null,
    "workspace_name": null,
    "last_sync_at": null,
    "_status_doc": "status_map 值为 TAPD 中文 v_status（按 docs/TAPD_Ticket_操作规范.md v1.0 预填）。AI 调状态推进 API 必须用 v_status 中文名（铁律 R-01）。完整枚举见 status_enum。",
    "status_enum": {
      "story": ["规划中", "To do", "实现中", "任务/测试完成", "已实现/上线", "关闭"],
      "task":  ["To do", "实现中", "任务/测试完成", "关闭"],
      "item":  ["To do", "进行中", "已完成"],
      "bug":   []
    },
    "status_map": {
      "story": {
        "to_dev": "To do",
        "to_review": "规划中",
        "to_test": "任务/测试完成",
        "done": "已实现/上线"
      },
      "task": {
        "to_dev": "To do",
        "to_review": null,
        "to_test": "任务/测试完成",
        "done": "关闭"
      },
      "item": {
        "to_do": "To do",
        "in_progress": "进行中",
        "done": "已完成"
      },
      "bug": {
        "to_dev": null,
        "to_review": null,
        "to_test": null,
        "done": null
      }
    },
    "comment_markers": {
      "consensus_approved": "[CONSENSUS-APPROVED]",
      "consensus_rejected": "[CONSENSUS-REJECTED:",
      "qa_passed": "[QA-PASSED]",
      "qa_rejected": "[QA-REJECTED:",
      "subtask_emitted": "[SUBTASK-EMITTED]"
    },
    "team_roles": {
      "pm": [],
      "be": [],
      "fe": [],
      "qa": [],
      "other": []
    }
  }
}
